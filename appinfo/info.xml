<?xml version="1.0"?>
<info>
	<id>text_anonymizer</id>
	<name>Text Anonymizer</name>
	<summary>Anonymize Text and Text Files</summary>
	<description>
	<![CDATA[Anonymize Text and Text Files]]>
	</description>
	<version>0.1.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="contact@edward.ly" homepage="https://edward.ly/">Edward Ly</author>
	<namespace>TextAnonymizer</namespace>
	<category>tools</category>
	<website>https://github.com/nextcloud/text_anonymizer</website>
	<bugs>https://github.com/nextcloud/text_anonymizer/issues</bugs>
	<repository type="git">https://github.com/nextcloud/text_anonymizer</repository>
	<dependencies>
		<nextcloud min-version="31" max-version="36"/>
	</dependencies>
	<external-app>
		<docker-install>
			<registry>ghcr.io</registry>
			<image>nextcloud/text_anonymizer</image>
			<image-tag>latest</image-tag>
		</docker-install>
		<routes>
			<route>
				<url>^/public$</url>
				<verb>GET</verb>
				<access_level>PUBLIC</access_level>
			</route>
			<route>
				<url>^/user$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/admin$</url>
				<verb>GET</verb>
				<access_level>ADMIN</access_level>
			</route>
			<route>
				<url>^/$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/ws$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
			</route>
		</routes>
	</external-app>
</info>
